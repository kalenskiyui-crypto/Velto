# Copy into Vercel → Project → Settings → Environment Variables (Production and Preview).
# Never commit real values. All of these are read only on the server (api/booking.js).

# demo (default): the booking form validates and answers OK without sending anything.
# live: refuse bookings (HTTP 503) when no delivery channel below is configured.
BOOKING_MODE=demo

# Option A — forward each booking as JSON to your CRM / automation (Make, Zapier, n8n, HubSpot…).
BOOKING_WEBHOOK_URL=
# Optional shared secret; requests carry X-Velto-Signature: sha256=<HMAC of the raw body>.
BOOKING_WEBHOOK_SECRET=

# Option B — notification e-mail to your team via Resend (https://resend.com).
RESEND_API_KEY=
BOOKING_EMAIL_FROM=Velto Bookings <bookings@your-domain.com>
BOOKING_EMAIL_TO=team@your-domain.com

# Extra origins allowed to POST to /api/booking (comma separated), e.g. a custom domain
# during migration. The site's own domain is always allowed.
ALLOWED_ORIGINS=

# Build time only (scripts in the design source), not needed on Vercel:
# SITE_URL=https://veltocars.com
